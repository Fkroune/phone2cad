# Cloudflare Pages response headers. The page CSP itself is a <meta> tag
# generated by SvelteKit (it needs per-build script hashes).
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The OpenCV.js worker runs WebAssembly and Emscripten glue code that needs
# eval; that permission is scoped to the worker only, never the page.
/cv/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self'; frame-ancestors 'none'

# Only the 13 MB OpenCV build is cached long; it changes only on an OpenCV upgrade.
# cv-worker.js / cv-core.js revalidate every load (and are versioned with ?v=<build>).
/cv/opencv.js
  Cache-Control: public, max-age=604800
