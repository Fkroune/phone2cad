# Copy to .env (gitignored) and fill in.
# The phone app. Empty = the public Phone2CAD app, https://phone2cad-app.pages.dev.
# Set it only if you host your own copy (scripts/deploy-web), e.g. https://<project>.pages.dev
PHONE2CAD_APP_URL=
# Allowed browser origin (CORS). Empty = the origin of PHONE2CAD_APP_URL.
PHONE2CAD_WEB_ORIGIN=
# Prebuilt server image instead of building locally, e.g. ghcr.io/fkroune/phone2cad:1.1.0
PHONE2CAD_IMAGE=
# Cloudflare Pages project name used by scripts/deploy-web (only if you host the app;
# empty = phone2cad-app, and Cloudflare adds a suffix to the address if that name is taken):
PHONE2CAD_PAGES_PROJECT=
# auto | cuda | cpu
PHONE2CAD_DENSE=auto
# Where scans are stored while processed and results until they expire. Empty =
# data/server in this folder. Keep it under your Linux home, not on /mnt/c (a Windows
# drive has no file permissions: any Windows program could read the scans).
PHONE2CAD_DATA_DIR=
# Results are deleted after this many hours (and job records after 7 days).
PHONE2CAD_RESULT_TTL_H=24
# Debugging only. You can also keep one scan's photos from the app (a checkbox next
# to the scan button); this sets it for every scan. Keeps scan frames in data/server/debug/
# (on this PC, gitignored) instead of deleting them: "failed" (failed scans) or "all". Empty = never.
# The photos may show your room. run-server warns while this is on. Delete that
# folder when done. (PHONE2CAD_KEEP_FAILED=1 is the old name for "failed".)
PHONE2CAD_KEEP_FRAMES=
# Locating frames: register (default: triangulate from the frames the mat located, then
# register the close-ups; minutes), accurate (map every frame from scratch, all pairs;
# ~30 min on an entry-level NVIDIA GPU (2 GB)) or fast (map from scratch, capture-order pairs).
PHONE2CAD_SFM_MODE=register
# Mat scale: measure 10 squares of the printed ring with a ruler, in mm (150 when the
# printer printed at exactly 100 %). Empty = nominal. Every measurement scales with it.
PHONE2CAD_MAT_10_SQUARES_MM=
